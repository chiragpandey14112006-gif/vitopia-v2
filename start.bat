@echo off
title VIT-O-PIA v2.0 Launcher
echo Starting VIT-O-PIA v2.0 Backend on http://127.0.0.1:8001 ...
start "VITOPIA Backend" cmd /k "cd /d "%~dp0backend" && python -m uvicorn main:app --host 127.0.0.1 --port 8001 --reload"
